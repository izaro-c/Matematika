{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "name": "Matematika API",
  "readme": "README.md",
  "exclude": [
    "**/*.(test|spec).ts",
    "**/*.(test|spec).tsx",
    "**/tests/**",
    "**/vite-env.d.ts"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "theme": "default",
  "plugin": []
}
