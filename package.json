{
  "name": "matematika",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://izaro-c.github.io/Matematika/",
  "scripts": {
    "dev": "npm run generate-index && npm run content:coverage && npm run validate-graph && npm run validate-references && vite",
    "prebuild": "npm run generate-index && npm run content:coverage && npm run validate-graph && npm run validate-references",
    "generate-index": "tsx scripts/core/generate-content-index.ts",
    "diagram-usages:index": "tsx scripts/editor/generate-diagram-usages.ts",
    "diagram-usages:check": "tsx scripts/editor/generate-diagram-usages.ts --check",
    "editor:diagrams:check": "tsx scripts/editor/check-diagrams-support.ts",
    "editor:diagrams:v3-check": "node --import tsx scripts/editor/migrateDiagramSpecsV3.ts",
    "editor:diagrams:v3-migrate": "node --import tsx scripts/editor/migrateDiagramSpecsV3.ts --write-verified",
    "content:coverage": "tsx scripts/core/generate-content-coverage.ts",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:build": "typedoc",
    "docs:check": "typedoc --treatValidationWarningsAsErrors",
    "validate-graph": "tsx scripts/core/validate-logical-graph.ts",
    "validate-references": "tsx scripts/core/validate-cross-references.ts",
    "full-check": "npm run lint && npm run typecheck && npm run test && npm run depcruise && npm run validate-references && npm run validate-graph && npm run content:coverage",
    "test": "vitest run",
    "test:fast": "vitest run --exclude 'tests/**/*.full.test.tsx' --exclude 'tests/features/editor/document/auditLossless.test.ts' --exclude 'tests/features/editor/catalog/resourceCatalog.test.ts'",
    "test:slow": "vitest run tests/diagrams/SampleWidgetsValidation.full.test.tsx tests/diagrams/RayDirectionStability.full.test.tsx tests/diagrams/DemoAnguloExternoRayStability.full.test.tsx tests/diagrams/SetExactPointPosition.test.ts",
    "test:corpus": "vitest run tests/features/editor/document/auditLossless.test.ts tests/features/editor/catalog/resourceCatalog.test.ts",
    "test:report": "tsx tests/scripts/generate-test-report.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tests/e2e/editor/editor-safe-ux.e2e.ts",
    "test:e2e:phase5": "tsx tests/e2e/editor/phase5-real-diagrams.e2e.ts",
    "editor:test:visual": "npm run test:e2e:phase5",
    "editor:roundtrip:audit": "tsx scripts/editor/audit-mdx-roundtrip.ts --audit",
    "editor:roundtrip:check": "tsx scripts/editor/audit-mdx-roundtrip.ts --check",
    "editor:roundtrip:strict": "tsx scripts/editor/audit-mdx-roundtrip.ts --strict",
    "test:editor": "vitest run tests/features/editor",
    "editor:test:unit": "vitest run tests/features/editor/document tests/features/editor/diagrams tests/features/editor/state tests/features/editor/parser.test.ts tests/features/editor/validation.test.ts tests/features/editor/editorContracts.test.ts tests/features/editor/fixtures.test.ts",
    "editor:test:integration": "vitest run tests/features/editor/persistence tests/features/editor/useEditorCore.test.ts tests/features/editor/roundtrip.test.ts",
    "editor:test:e2e": "tsx scripts/editor/check-editor-e2e-suite.ts && tsx tests/e2e/editor/editor-safe-ux.e2e.ts",
    "editor:test:coverage": "vitest run tests/features/editor --test-timeout=180000 --coverage --coverage.include='src/fixed-pages/editor/**' --coverage.reporter=text --coverage.reporter=json-summary && tsx scripts/editor/check-editor-coverage.ts",
    "editor:lint": "eslint src/fixed-pages/editor tests/features/editor scripts/editor vite.config.ts --max-warnings=119",
    "editor:architecture": "npm run depcruise && npm run editor:safety:check",
    "editor:safety:check": "tsx scripts/editor/check-editor-safety.ts",
    "editor:generated:check": "tsx scripts/editor/check-generated-artifacts.ts",
    "editor:full-check": "npm run editor:generated:check && npm run editor:roundtrip:check && npm run editor:lint && npm run editor:test:unit && npm run editor:test:integration && npm run editor:architecture && npm run typecheck && npm run build",
    "editor:server": "tsx scripts/editor/editorApiServer.ts",
    "editor:release-check": "npm run editor:full-check && npm run editor:test:coverage && npm run editor:test:e2e && npm run editor:test:visual && npm run validate-references && npm run validate-graph",
    "editor:lossless:audit": "tsx scripts/editor/audit-lossless-compatibility.ts --audit",
    "editor:lossless:check": "tsx scripts/editor/audit-lossless-compatibility.ts --check",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "depcruise": "depcruise src content/diagrams",
    "depcruise:graph": "depcruise src content/diagrams --output-type dot | dot -T svg > docs/dependency_graph.svg",
    "depcruise:report": "depcruise src content/diagrams --output-type err-html > docs/dependency_report.html",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@oddbird/css-anchor-positioning": "^0.10.1",
    "@oddbird/popover-polyfill": "^0.7.1",
    "@react-three/drei": "^9.109.5",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@xyflow/react": "^12.11.0",
    "fuse.js": "^7.4.2",
    "jsxgraph": "^1.12.2",
    "katex": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.184.0",
    "wouter": "^3.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "puppeteer": "^24.43.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
